# Copy this file to .env and fill in the API key and service URLs.
# Process environment variables override values loaded from .env.

# Model provider
RAG_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ENDPOINT=
OPENAI_API_VERSION=
OPENAI_MODEL=gpt-4o-mini

# Embedding provider
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_ENDPOINT=
OPENAI_EMBEDDING_API_VERSION=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIM=

# Retrieval and reranking
RAG_RETRIEVAL_BACKEND=hybrid
RAG_SEARCH_BACKEND=bi_encoder
RAG_RERANKER_BACKEND=cross_encoder
RAG_TOP_K=4
RAG_CROSS_ENCODER_WEIGHT=0.95
RAG_CROSS_ENCODER_RETRIEVAL_SCORE_WEIGHT=0.05
RAG_COLBERT_MODEL=
RAG_COLBERT_QUERY_MAX_TOKENS=32
RAG_COLBERT_DOCUMENT_MAX_TOKENS=180
RAG_COLBERT_BATCH_SIZE=8
RAG_COLBERT_INTERACTION_WEIGHT=0.95
RAG_COLBERT_RETRIEVAL_SCORE_WEIGHT=0.05
RAG_COLBERT_HASHING_DIM=64

# Chunking and hierarchy
RAG_CHUNK_SIZE=300
RAG_CHUNK_OVERLAP=50
RAG_PARENT_CHILD=false

# Storage. Empty paths use project-local defaults under data/stores.
RAG_VECTOR_BACKEND=sqlite
RAG_SQLITE_PATH=
RAG_MANIFEST_PATH=
RAG_PG_DSN=

# PDF OCR
RAG_OCR_LANG=ch
RAG_OCR_ZOOM=2.0
RAG_OCR_THRESHOLD=170

# Provider health check
RAG_CHECK_EMBEDDING=false

# Offline mock provider (double opt-in, both required).
# Mock returns deterministic local stubs: embeddings pollute persisted indexes
# and LLM answers are fabricated. Never enable outside offline verification.
# RAG_PROVIDER=mock
# RAG_ALLOW_MOCK_PROVIDER=1
